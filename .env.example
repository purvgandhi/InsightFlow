# Copy to .env for local development. Never commit .env.

# API connection. On Neon use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: direct (non-pooled) connection used by scripts/load_data.py for bulk imports.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: timezone used to group days/weeks/months (default Asia/Kolkata).
REPORTING_TZ=Asia/Kolkata

# Optional, tests only: a throwaway database whose tables will be truncated.
TEST_DATABASE_URL=postgresql://postgres:devpass@localhost:5433/insightflow_test
