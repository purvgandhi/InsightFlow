{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/app.py"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 15,
      "excludeFiles": "{tests/**,data/**,scripts/**,public/**,.venv/**,**/__pycache__/**}"
    }
  }
}

